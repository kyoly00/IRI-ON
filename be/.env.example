# 기존 DB/OpenAI 값은 실제 비밀값을 be/.env에만 넣는다.
OPENAI_API_KEY=

# Custom cascade는 OpenAI Realtime 모델이 아닌 독립 STT/LLM/TTS를 사용한다.
CUSTOM_VOICE_STT_MODEL=gpt-4o-mini-transcribe
CUSTOM_VOICE_LLM_MODEL=gpt-4.1-mini
CUSTOM_VOICE_TTS_MODEL=tts-1
CUSTOM_VOICE_TTS_VOICE=alloy

# 오디오 계약과 endpointing 기준. deep NS 모드만 transport가 48000이고 VAD/STT는 16000이다.
CUSTOM_VOICE_INPUT_RATE=16000
CUSTOM_VOICE_OUTPUT_RATE=24000
CUSTOM_VOICE_ENDPOINT_MS=720
CUSTOM_VOICE_SPEECH_START_FRAMES=5
CUSTOM_VOICE_VAD_MULTIPLIER=2.8
CUSTOM_VOICE_VAD_MIN_RMS=850
CUSTOM_VOICE_MIN_UTTERANCE_RMS=0.025
CUSTOM_VOICE_PROVIDER_TIMEOUT=45

# Noise suppression experiment. Deep modes keep browser AEC but disable browser NS,
# receive 48 kHz PCM, run the selected model, then anti-alias downsample to 16 kHz.
CUSTOM_VOICE_NOISE_SUPPRESSION=browser
CUSTOM_VOICE_FRAME_MS=20
CUSTOM_VOICE_RNNOISE_LIBRARY=
CUSTOM_VOICE_DEEPFILTERNET_MODEL=

# OpenAI-compatible provider로 교체할 때만 지정한다.
CUSTOM_VOICE_OPENAI_BASE_URL=https://api.openai.com/v1
