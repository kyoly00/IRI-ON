ENVIRONMENT=production
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DB_NAME?charset=utf8mb4
DB_SSL_CA=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=https://app.example.com
OPENAI_API_KEY=
GEMINI_API_KEY=
FRIDGE_VISION_MODEL=gpt-4o-mini
RECIPE_TIMELINE_TIMEOUT_SECONDS=30
RECIPE_TIMELINE_MAX_RETRIES=1
LEGACY_EXTERNAL_API_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_LEGACY_ASSISTANT=false
