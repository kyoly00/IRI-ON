ENVIRONMENT=production
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DB_NAME?charset=utf8mb4
DB_SSL_CA=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=https://app.example.com
YOUTUBE_RECIPE_FETCH_COMMENTS=true
YOUTUBE_RECIPE_ENABLE_OCR=true
YOUTUBE_RECIPE_OCR_MAX_VIDEO_SECONDS=60
YOUTUBE_RECIPE_MAX_VIDEO_SECONDS=1800
YOUTUBE_RECIPE_MAX_VIDEO_MB=250
YOUTUBE_RECIPE_OCR_INTERVAL_SECONDS=1
YOUTUBE_RECIPE_OCR_LOWER_RATIO=0.4
YOUTUBE_RECIPE_OCR_MAX_SAMPLES=1800
YOUTUBE_RECIPE_OCR_FRAME_DIFF_THRESHOLD=0.008
EASYOCR_MODEL_DIR=/tmp/easyocr-models
OPENAI_API_KEY=
GEMINI_API_KEY=
FRIDGE_VISION_MODEL=gpt-4o-mini
RECIPE_TIMELINE_TIMEOUT_SECONDS=30
RECIPE_TIMELINE_MAX_RETRIES=1
LEGACY_EXTERNAL_API_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_LEGACY_ASSISTANT=false
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
AVATAR_MAX_UPLOAD_BYTES=2097152
